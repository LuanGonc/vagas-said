# Copie para .env na raiz e preencha os três campos abaixo.
# Crie seu bot no @BotFather para obter BOT_TOKEN.
BOT_TOKEN=

# Conta UERJ única do responsável. Escreva os valores entre as aspas.
UERJ_MATRICULA=''
UERJ_SENHA=''

# Necessário apenas para comandos de diagnóstico de envio e o monitor legado.
# O comando bot ignora CHAT_ID e usa a conversa privada de cada pessoa.
CHAT_ID=
