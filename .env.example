# Preencha somente na cópia local .env. Nunca envie o token pelo chat ou pelo Git.
# Crie seu bot no @BotFather e envie /start para ele antes de descobrir o CHAT_ID.
BOT_TOKEN=
# Necessário apenas para comandos de diagnóstico de envio e o monitor legado.
# O comando bot ignora CHAT_ID e usa a conversa privada de cada pessoa.
CHAT_ID=

# Opcionais: portal check --env-file .env ou bot com [portal] env_file = ".env".
# Também podem ser definidas no ambiente: --from-env ou [portal] from_env = true.
# Por padrão, só o responsável digita no terminal; a sessão fica em memória.
UERJ_MATRICULA=
UERJ_SENHA=
